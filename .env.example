CLUSTER=pred-main-mlops
S3_ACCESS_KEY=admin
S3_SECRET_KEY=admin123
S3_BUCKET=pred-main-dvc
S3_ENDPOINT_EXTERNAL=http://s3.localhost
S3_ENDPOINT_INTERNAL=http://rustfs.mlops:9000

# Для deploy: такое же значение нужно задать в GitHub Secret DB_PASSWORD.
# up.sh не создает PostgreSQL и не меняет пароль существующей базы.
DB_PASSWORD=postgres
